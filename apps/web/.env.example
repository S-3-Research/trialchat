OPENAI_API_KEY=sk-proj-...
NEXT_PUBLIC_CHATKIT_WORKFLOW_ID=wf_...

# Supabase Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only — 不要加 NEXT_PUBLIC_ 前缀，仅在 API routes 中使用，会绕过 RLS
SUPABASE_SECRET_KEY=sb_secret_...

# Clinical Trials API
CLINICAL_TRIALS_API_KEY=your_api_key_here

# OpenWeather API (optional, for weather widget)
OPENWEATHER_API_KEY=your_openweather_key

# Mapbox (for Nurse Match map)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token
ADMIN_PASSWORD=your_admin_password_here

# 调试日志开关
# dev 模式（npm run dev）自动开启；production 如需强制开启则设为 true
# NEXT_PUBLIC_DEBUG=true

# 内部开发工具密码保护（dev-test / dev-test/history / voice-test）
DEV_PASSWORD=your-secret-password
