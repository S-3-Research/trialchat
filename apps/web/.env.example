OPENAI_API_KEY=sk-proj-...
NEXT_PUBLIC_CHATKIT_WORKFLOW_ID=wf_...

# LangGraph Agent Server (apps/agent) — used by /api/agent proxy
# Host-based dev: http://localhost:2024
# Docker Compose: http://agent:2024 (set automatically in docker-compose.yml)
LANGGRAPH_API_URL=http://localhost:2024
# Optional: API key forwarded as `x-api-key` to the agent server. Only
# needed if the agent is deployed behind auth (e.g. LangGraph Platform).
# Leave unset for self-hosted/Docker-network agents with no auth layer.
# LANGGRAPH_API_KEY=your_agent_api_key
# Optional: graph id to run, matches apps/agent/langgraph.json ("agent" by default)
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=agent

# Supabase Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only — 不要加 NEXT_PUBLIC_ 前缀，仅在 API routes 中使用，会绕过 RLS
SUPABASE_SECRET_KEY=sb_secret_...

# Clinical Trials API
CLINICAL_TRIALS_API_KEY=your_api_key_here

# OpenWeather API (optional, for weather widget)
OPENWEATHER_API_KEY=your_openweather_key

# Mapbox (for Nurse Match map)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token
ADMIN_PASSWORD=your_admin_password_here

# 调试日志开关
# dev 模式（npm run dev）自动开启；production 如需强制开启则设为 true
# NEXT_PUBLIC_DEBUG=true

# 内部开发工具密码保护（dev-test / dev-test/history / voice-test）
DEV_PASSWORD=your-secret-password

# 全局站点密码保护（可选）。设置后，整站会要求浏览器 Basic Auth 登录才能访问
# （用户名随意，密码需匹配此值）。留空/不设置则整站保持公开，不受影响。
# 适合部署预览/demo 环境，避免被搜索引擎或陌生人访问到。
# SITE_PASSWORD=your-site-wide-password
