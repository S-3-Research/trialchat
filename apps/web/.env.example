# Web configuration (apps/web).
# Local development: copy this file to apps/web/.env.local.
# Hosted web app: set these variables in the WEB deployment settings.
# NEXT_PUBLIC_* values are exposed to the browser and set at build time.
# Never put API keys/passwords in NEXT_PUBLIC_* variables.

# Agent connection — the web server proxies browser requests to this URL.
# Host-based local development:
LANGGRAPH_API_URL=http://localhost:2024
# Local Docker Compose overrides this automatically with http://agent:2024.
# Hosted web -> LangGraph Cloud: REPLACE the localhost value with the deployment
# URL and set its API key below. Set these on web, not on the agent deployment.
# LANGGRAPH_API_URL=https://your-agent-deployment.example.com
# LANGGRAPH_API_KEY=your_langgraph_cloud_api_key
# Local unauthenticated agent: omit LANGGRAPH_API_KEY.
# Self-hosted agent: use its reachable URL and authentication requirements.
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=agent

# Web-side OpenAI features: thread titles, Whisper dictation.
# The agent also needs its own OPENAI_API_KEY in its separate environment.
OPENAI_API_KEY=sk-proj-...

# Web business data: profiles, intake and link events via Supabase API routes.
# These remain applicable whether the agent is local or on LangGraph Cloud.
# They do NOT configure LangGraph's conversation/checkpoint persistence.
# The web app does not read DATABASE_URL; do not add an agent Postgres URL here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only secret; used by API routes and bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_...

# Trial Panel search runs through web API routes, so web needs this key too.
CLINICAL_TRIALS_API_KEY=your_api_key_here

# Access controls for admin, internal dev tools and demo pages.
ADMIN_PASSWORD=your_admin_password_here
DEV_PASSWORD=your_dev_password_here
# TRIAL_CHAT_PASSWORD=your_trial_chat_demo_password
# MASTER_DEMO_PASSWORD=your_master_demo_password
# Optional site-wide Basic Auth (any username, this password).
# Omit to leave site-wide Basic Auth disabled.
# SITE_PASSWORD=your_site_wide_password

# General debug logs: enabled in development; opt in for production builds.
# NEXT_PUBLIC_DEBUG=true
# LangGraph stream diagnostics are separate and need no deployment env change:
# browser Console: localStorage.setItem("trialchat:debug-stream", "1")
# disable: localStorage.removeItem("trialchat:debug-stream")
