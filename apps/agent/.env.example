OPENAI_API_KEY=sk-proj-...
AGENT_MODEL=gpt-4o-mini

# Postgres connection string used to persist thread/checkpoint state so
# conversations survive server restarts. If omitted, an in-memory
# checkpointer is used (state lost on restart) — fine for quick local
# hacking but not for anything you want to keep.
# Local docker-compose Postgres: postgres://acadia:acadia@postgres:5432/acadia_agent
# Or point this at your Supabase project's Postgres connection string.
DATABASE_URL=

# Clinical trials search tool (get_trials) — same key used by the legacy
# ChatKit tool handler in apps/web.
CLINICAL_TRIALS_API_KEY=

# LangSmith tracing (required for LangGraph Studio in-app traces)
# Get an API key from https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=acadia-trialchat-agent
