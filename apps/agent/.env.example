OPENAI_API_KEY=sk-proj-...
AGENT_MODEL=gpt-4o-mini

# Postgres connection string used to persist thread/checkpoint state so
# conversations survive server restarts. If omitted, an in-memory
# checkpointer is used (state lost on restart) — fine for quick local
# hacking but NOT for production.
# Local docker-compose Postgres: postgres://acadia:acadia@postgres:5432/acadia_agent
# Or point this at a Supabase project's Postgres connection string:
#   Supabase dashboard → Project Settings → Database → Connection string
#   → use the "URI" format under "Direct connection" (port 5432), NOT the
#     "Transaction pooler" (port 6543) string — LangGraph's checkpointer
#     uses prepared statements, which aren't compatible with PgBouncer's
#     transaction pooling mode.
#   Replace the [YOUR-PASSWORD] placeholder with your database password
#   (set/reset it from the same Database settings page).
#   No manual table setup needed — the checkpointer creates its own
#   tables automatically on first startup.
# Example: postgresql://postgres:your-password@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# Clinical trials search tool (get_trials) — same key used by the legacy
# ChatKit tool handler in apps/web.
CLINICAL_TRIALS_API_KEY=

# Optional: OpenAI vector store ID enabling the knowledge_base tool. If
# unset, the tool is simply disabled (no error) — see
# src/tools/registry.ts.
# OPENAI_VECTOR_STORE_ID=

# Optional: override the default model used by specific nodes/tools.
# Safe to leave unset — each has a working default.
# SUGGESTIONS_MODEL=gpt-5.4-mini
# WEB_SEARCH_MODEL=gpt-4o-mini
# INTENTION_MODEL=gpt-4o-mini

# LangSmith tracing (optional — purely for observability/debugging in
# LangGraph Studio; has zero effect on runtime behavior if left unset).
# Get an API key from https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=acadia-trialchat-agent
