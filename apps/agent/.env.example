# Agent configuration (apps/agent).
# Local development: copy this file to apps/agent/.env.local.
# LangGraph Cloud: set the relevant variables in the agent deployment settings.
# Web deployment variables belong in apps/web/.env.example, not here.

# Required: model access and clinical trial search.
OPENAI_API_KEY=sk-proj-...
CLINICAL_TRIALS_API_KEY=your_api_key_here

# Checkpoint persistence — choose based on HOW the agent runs, not its location.
#
# LangGraph Cloud (managed Agent Server):
#   OMIT DATABASE_URL. The platform manages thread/checkpoint persistence.
#   Setting this application variable does not redirect the platform database.
#   Our graph factory still calls PostgresSaver.setup() if it is set, which can
#   create empty checkpoint tables even when runtime writes go elsewhere.
#
# Local Docker Compose (this repository's docker-compose.yml):
#   No manual DATABASE_URL needed: Compose injects the local Postgres URL below.
#   Its environment entry overrides DATABASE_URL from apps/agent/.env.local.
#   Injected value: postgres://acadia:acadia@postgres:5432/acadia_agent
#   This setup runs langgraphjs dev; it is not a production Agent Server setup.
#
# Direct graph execution (your own process calling graph.invoke/stream):
#   Set DATABASE_URL to use this application's PostgresSaver.
#   Without it, getCheckpointer() returns MemorySaver (process-local state).
#   Example for the Compose database accessed from the host:
# DATABASE_URL=postgresql://acadia:acadia@localhost:5432/acadia_agent
#
# langgraphjs dev / self-hosted Agent Server:
#   The server manages persistence separately. Do not assume this application's
#   DATABASE_URL configures server persistence, even if setup() creates tables.
#   For a production self-hosted server, use its deployment-level database
#   configuration; DATABASE_URL here is only read by src/checkpointer.ts.
#
# This is separate from the web app's Supabase business-data configuration.

# Optional: enable the knowledge_base tool with an OpenAI vector store.
# OPENAI_VECTOR_STORE_ID=

# Optional model overrides. Omit to retain the defaults in src/configs/.
# AGENT_MODEL affects api_agent and other_questions, not the knowledge branch.
# AGENT_MODEL=gpt-5-mini
# SUGGESTIONS_MODEL=gpt-5.4-mini
# WEB_SEARCH_MODEL=gpt-4o-mini
# INTENTION_MODEL=gpt-4o-mini

# Optional local/self-hosted tracing. This is observability, not persistence.
# LangGraph Cloud manages tracing credentials; no manual values needed here
# for the standard managed deployment.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key
# LANGSMITH_PROJECT=acadia-trialchat-agent
