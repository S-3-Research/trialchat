# Root-level env reference for the monorepo.
# Actual runtime env files live per-app:
#   apps/web/.env.local     (copy from apps/web/.env.example — real OPENAI_API_KEY etc. goes here)
#   apps/agent/.env         (copy from apps/agent/.env.example — real OPENAI_API_KEY etc. goes here)
#
# This file only documents variables that cross the web <-> agent boundary.
# It is not loaded automatically by either app.

# Host-based local dev (running `npm run dev:web` + `npm run dev:agent` directly):
LANGGRAPH_API_URL=http://localhost:2024

# When both services run inside `docker compose up`, the web container
# instead talks to the agent container by its Compose service name:
# LANGGRAPH_API_URL=http://agent:2024
